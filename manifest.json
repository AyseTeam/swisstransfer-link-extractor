{
  "manifest_version": 3,
  "name": "SwissTransfer Direct Link Extractor",
  "version": "3.0",
  "description": "Génère les liens de téléchargement directs en un clic.",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.swisstransfer.com/*"],
      "js": ["main.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}